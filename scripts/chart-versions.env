# shellcheck shell=bash
# Helm chart versions used by the provisioning scripts.
#
# Every chart is pinned. Leaving them floating is how challenge content silently
# breaks: an upstream release that drops an API version makes a challenge's
# setup.yaml unappliable, and nothing in CI notices. Two challenges broke exactly
# that way before these pins existed.
#
# Renovate keeps these current (see renovate.json); bump them deliberately and
# re-run the challenges before merging.
#
# shellcheck disable=SC2034  # consumed by the provisioning scripts that source this

# renovate: datasource=helm registryUrl=https://argoproj.github.io/argo-helm depName=argo-cd
ARGOCD_CHART_VERSION="10.8.4"
# renovate: datasource=helm registryUrl=https://argoproj.github.io/argo-helm depName=argo-rollouts
ARGO_ROLLOUTS_CHART_VERSION="2.43.1"
# renovate: datasource=helm registryUrl=https://kyverno.github.io/kyverno/ depName=kyverno
KYVERNO_CHART_VERSION="3.9.0"
# renovate: datasource=helm registryUrl=https://open-policy-agent.github.io/gatekeeper/charts depName=gatekeeper
GATEKEEPER_CHART_VERSION="3.23.1"
# renovate: datasource=helm registryUrl=https://jaegertracing.github.io/helm-charts depName=jaeger
JAEGER_CHART_VERSION="4.13.1"
# renovate: datasource=helm registryUrl=https://charts.crossplane.io/stable depName=crossplane
CROSSPLANE_CHART_VERSION="2.4.0"
# Applies to both istio/base and istio/istiod - the two charts are released in
# lockstep and must not drift apart, so Renovate tracks base and both follow.
# renovate: datasource=helm registryUrl=https://istio-release.storage.googleapis.com/charts depName=base
ISTIO_CHART_VERSION="1.30.4"
# renovate: datasource=helm registryUrl=https://charts.external-secrets.io depName=external-secrets
EXTERNAL_SECRETS_CHART_VERSION="2.10.0"
# renovate: datasource=helm registryUrl=https://prometheus-community.github.io/helm-charts depName=kube-prometheus-stack
PROMETHEUS_STACK_CHART_VERSION="90.0.0"
# renovate: datasource=helm registryUrl=https://opencost.github.io/opencost-helm-chart depName=opencost
OPENCOST_CHART_VERSION="2.5.30"
# renovate: datasource=helm registryUrl=https://kubernetes-sigs.github.io/metrics-server/ depName=metrics-server
METRICS_SERVER_CHART_VERSION="3.14.0"
